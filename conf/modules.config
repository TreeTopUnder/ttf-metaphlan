/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ttf-metaphlan module arguments, resources, and publishDir
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    publishDir = [
        path: { "${params.outdir}/pipeline_info" },
        mode: params.publish_dir_mode,
        enabled: false
    ]

    withName: FASTP {
        cpus     = { check_max(4, 'cpus') }
        memory   = { check_max(8.GB, 'memory') }
        ext.args = { "--length_required ${params.min_read_len}" }
        publishDir = [
            path: { "${params.outdir}/qc/fastp" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith('.fastp.json') || filename.endsWith('.fastp.html') ? filename : null
            }
        ]
    }

    withName: BOWTIE2_ALIGN {
        cpus   = { check_max(8, 'cpus') }
        memory = { check_max(16.GB, 'memory') }
        // Publish ONLY Bowtie2 logs. Never publish host-aligned BAMs or host reads.
        publishDir = [
            path: { "${params.outdir}/host_removal" },
            mode: params.publish_dir_mode,
            pattern: "*.bowtie2.log"
        ]
    }

    withName: METAPHLAN_METAPHLAN {
        cpus   = { check_max(8, 'cpus') }
        memory = { check_max(32.GB, 'memory') }
        ext.args = {
            def args = "-t ${params.analysis_type}"
            if (params.unclassified_estimation) {
                args += " --unclassified_estimation"
            }
            if (params.add_viruses) {
                args += " --add_viruses"
            }
            if (params.run_strainphlan) {
                args += " -s ${meta.id}.sam.bz2"
            }
            args
        }
        publishDir = [
            path: { "${params.outdir}/metaphlan" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                // Never publish bulky StrainPhlAn SAM intermediates.
                if (filename.endsWith('.sam.bz2') || filename.endsWith('.sam')) {
                    return null
                }
                filename.endsWith('_profile.txt') || filename.endsWith('.biom') ? filename : null
            }
        ]
    }

    withName: METAPHLAN_MERGEMETAPHLANTABLES {
        cpus       = { check_max(2, 'cpus') }
        memory     = { check_max(4.GB, 'memory') }
        ext.prefix = 'merged_abundance_table'
        publishDir = [
            path: { "${params.outdir}/metaphlan" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'merged_abundance_table.txt' ? 'merged_abundance_table.tsv' : null }
        ]
    }

    withName: METAPHLAN_TIDY_TABLES {
        cpus   = { check_max(2, 'cpus') }
        memory = { check_max(4.GB, 'memory') }
        publishDir = [
            [
                path: { "${params.outdir}/metaphlan" },
                mode: params.publish_dir_mode,
                pattern: "merged_{species,sgb}_table.tsv"
            ],
            [
                path: { "${params.outdir}/host_removal" },
                mode: params.publish_dir_mode,
                pattern: "host_removal_summary.tsv",
                enabled: { !params.skip_host_removal }
            ]
        ]
    }

    withName: BUILD_PHYLOSEQ {
        cpus   = { check_max(2, 'cpus') }
        memory = { check_max(4.GB, 'memory') }
        publishDir = [
            path: { "${params.outdir}/phyloseq" },
            mode: params.publish_dir_mode,
            pattern: "metaphlan_phyloseq.rds"
        ]
    }

    withName: METAPHLAN_TO_KRONA {
        cpus   = { check_max(2, 'cpus') }
        memory = { check_max(4.GB, 'memory') }
        publishDir = [ enabled: false ]
    }

    withName: KRONA_PER_SAMPLE {
        cpus       = { check_max(2, 'cpus') }
        memory     = { check_max(4.GB, 'memory') }
        ext.prefix = { "${meta.id}.krona" }
        publishDir = [
            path: { "${params.outdir}/krona" },
            mode: params.publish_dir_mode,
            pattern: "*.html"
        ]
    }

    withName: KRONA_COMBINED {
        cpus       = { check_max(2, 'cpus') }
        memory     = { check_max(4.GB, 'memory') }
        ext.prefix = 'krona_combined'
        publishDir = [
            path: { "${params.outdir}/krona" },
            mode: params.publish_dir_mode,
            pattern: "*.html"
        ]
    }

    withName: 'UNTAR_HOST_INDEX|UNTAR_METAPHLAN_DB' {
        cpus      = { check_max(2, 'cpus') }
        memory    = { check_max(4.GB, 'memory') }
        publishDir = [ enabled: false ]
    }

    withName: STRAINPHLAN_SAMPLE2MARKERS {
        cpus   = { check_max(4, 'cpus') }
        memory = { check_max(16.GB, 'memory') }
        publishDir = [
            path: { "${params.outdir}/strainphlan/consensus_markers" },
            mode: params.publish_dir_mode,
            pattern: "*.{json.bz2,pkl}"
        ]
    }

    withName: STRAINPHLAN_SELECT_CLADES {
        cpus   = { check_max(2, 'cpus') }
        memory = { check_max(4.GB, 'memory') }
        publishDir = [
            path: { "${params.outdir}/strainphlan" },
            mode: params.publish_dir_mode,
            pattern: "{strainphlan_summary.tsv,selected_clades.txt}"
        ]
    }

    withName: STRAINPHLAN_CLADE {
        cpus   = { check_max(4, 'cpus') }
        memory = { check_max(16.GB, 'memory') }
        ext.args = { "--phylophlan_mode ${params.strainphlan_phylophlan_mode}" }
        publishDir = [
            path: { "${params.outdir}/strainphlan" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: MULTIQC {
        cpus   = { check_max(2, 'cpus') }
        memory = { check_max(4.GB, 'memory') }
        ext.prefix = 'multiqc_report'
        publishDir = [
            [
                path: { "${params.outdir}/multiqc" },
                mode: params.publish_dir_mode,
                pattern: '*multiqc_report.html'
            ],
            [
                path: { "${params.outdir}/multiqc" },
                mode: params.publish_dir_mode,
                pattern: '*_data'
            ]
        ]
    }
}
