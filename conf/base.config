/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ttf-metaphlan base config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    cpus   = 1
    memory = 4.GB
    time   = 4.h

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = 4.GB
        time   = 4.h
    }
    withLabel: process_low {
        cpus   = 2
        memory = 4.GB
        time   = 4.h
    }
    withLabel: process_medium {
        cpus   = 4
        memory = 8.GB
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = 8
        memory = 16.GB
        time   = 8.h
    }

    withName: FASTP {
        cpus   = 4
        memory = 8.GB
        time   = 4.h
    }
    withName: BOWTIE2_ALIGN {
        cpus   = 8
        memory = 16.GB
        time   = 8.h
    }
    withName: METAPHLAN_METAPHLAN {
        cpus   = 8
        memory = 32.GB
        time   = 12.h
    }
    withName: 'UNTAR_HOST_INDEX|UNTAR_METAPHLAN_DB|METAPHLAN_MERGEMETAPHLANTABLES|METAPHLAN_TIDY_TABLES|BUILD_PHYLOSEQ|METAPHLAN_TO_KRONA|KRONA_PER_SAMPLE|KRONA_COMBINED|STRAINPHLAN_SELECT_CLADES|MULTIQC' {
        cpus   = 2
        memory = 4.GB
        time   = 4.h
    }
    withName: STRAINPHLAN_SAMPLE2MARKERS {
        cpus   = 4
        memory = 16.GB
        time   = 8.h
    }
    withName: STRAINPHLAN_CLADE {
        cpus   = 4
        memory = 16.GB
        time   = 8.h
    }
}
