/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AWS Batch profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use S3 paths for -work-dir and --outdir, for example:
      nextflow run . -profile awsbatch \
        --aws_queue <queue> \
        --aws_region us-east-1 \
        -work-dir s3://bucket/work \
        --outdir s3://bucket/results
----------------------------------------------------------------------------------------
*/

if (!params.aws_queue) {
    throw new Exception("The awsbatch profile requires --aws_queue (and typically an s3:// workDir/outdir)")
}

process {
    executor = 'awsbatch'
    queue    = params.aws_queue
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: FASTP {
        cpus   = { check_max(4, 'cpus') }
        memory = { check_max(8.GB, 'memory') }
    }
    withName: BOWTIE2_ALIGN {
        cpus   = { check_max(8, 'cpus') }
        memory = { check_max(16.GB, 'memory') }
    }
    withName: METAPHLAN_METAPHLAN {
        cpus   = { check_max(8, 'cpus') }
        memory = { check_max(32.GB, 'memory') }
    }
    withName: 'UNTAR_HOST_INDEX|UNTAR_METAPHLAN_DB|METAPHLAN_MERGEMETAPHLANTABLES|METAPHLAN_TIDY_TABLES|BUILD_PHYLOSEQ|METAPHLAN_TO_KRONA|KRONA_PER_SAMPLE|KRONA_COMBINED|MULTIQC' {
        cpus   = { check_max(2, 'cpus') }
        memory = { check_max(4.GB, 'memory') }
    }
}

aws {
    region = params.aws_region
    client {
        maxConnections = 20
    }
    batch {
        cliPath = params.aws_cli_path
    }
}

docker {
    enabled    = true
    registry   = 'quay.io'
    runOptions = '-u $(id -u):$(id -g)'
}

singularity.enabled = false
conda.enabled       = false
