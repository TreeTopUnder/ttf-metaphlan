/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AWS Batch profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TreeTopFlow controllers run:
      nextflow run . -profile awsbatch -c <worker/awsbatch.config>
    without --aws_queue. The worker config sets process.queue, aws.region, and
    aws.batch.cliPath. Optional CLI params only apply when explicitly set so they
    never throw or clobber the -c file.

    Direct use (optional):
      nextflow run . -profile awsbatch \
        --aws_queue <queue> \
        --aws_region eu-west-1 \
        -work-dir s3://bucket/work \
        --outdir s3://bucket/results
----------------------------------------------------------------------------------------
*/

process {
    executor = 'awsbatch'
    queue    = params.aws_queue
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: FASTP {
        cpus   = 4
        memory = 8.GB
    }
    withName: BOWTIE2_ALIGN {
        cpus   = 8
        memory = 16.GB
    }
    withName: METAPHLAN_METAPHLAN {
        cpus   = 8
        memory = 32.GB
    }
    withName: 'UNTAR_HOST_INDEX|UNTAR_METAPHLAN_DB|METAPHLAN_MERGEMETAPHLANTABLES|METAPHLAN_TIDY_TABLES|BUILD_PHYLOSEQ|METAPHLAN_TO_KRONA|KRONA_PER_SAMPLE|KRONA_COMBINED|STRAINPHLAN_SELECT_CLADES|MULTIQC' {
        cpus   = 2
        memory = 4.GB
    }
    withName: STRAINPHLAN_SAMPLE2MARKERS {
        cpus   = 4
        memory = 16.GB
    }
    withName: STRAINPHLAN_CLADE {
        cpus   = 4
        memory = 16.GB
    }
}

aws {
    client {
        maxConnections = 20
    }
    region = params.aws_region ?: System.getenv('AWS_REGION')
    batch {
        cliPath = params.aws_cli_path
    }
}

docker.enabled      = false
singularity.enabled = false
conda.enabled       = false
