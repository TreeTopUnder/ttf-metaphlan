/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Test / stub-run profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    input                   = "${projectDir}/tests/fixtures/samplesheet.csv"
    metadata                = "${projectDir}/tests/fixtures/metadata.tsv"
    outdir                  = "${projectDir}/work/test-results"
    // Override S3/refdb defaults so -profile test stays fully offline.
    metaphlan_db            = "${projectDir}/tests/fixtures/metaphlan_db"
    host_index              = "${projectDir}/tests/fixtures/host_index"
    skip_host_removal       = false
    analysis_type           = 'rel_ab_w_read_stats'
    add_viruses             = false
    unclassified_estimation = true
    min_read_len            = 70
    skip_krona              = false
    skip_phyloseq           = false
    run_strainphlan         = false
    strainphlan_clades      = null
    strainphlan_top_n       = 5
    strainphlan_min_samples = 4
    strainphlan_phylophlan_mode = 'fast'
    max_cpus                = 2
    max_memory              = '4.GB'
    max_time                = '1.h'
}

process {
    executor = 'local'
    cpus   = 2
    memory = 4.GB
    time   = 1.h
    resourceLimits = [
        cpus  : 2,
        memory: 4.GB,
        time  : 1.h,
    ]
    conda.enabled       = false
    docker.enabled      = false
    singularity.enabled = false
    beforeScript = """
    export PATH="${projectDir}/tests/stub_bin:\$PATH"
    """

    withName: FASTP {
        cpus   = 2
        memory = 4.GB
    }
    withName: BOWTIE2_ALIGN {
        cpus   = 2
        memory = 4.GB
    }
    withName: METAPHLAN_METAPHLAN {
        cpus   = 2
        memory = 4.GB
    }
    withName: 'UNTAR_HOST_INDEX|UNTAR_METAPHLAN_DB|METAPHLAN_MERGEMETAPHLANTABLES|METAPHLAN_TIDY_TABLES|BUILD_PHYLOSEQ|METAPHLAN_TO_KRONA|KRONA_PER_SAMPLE|KRONA_COMBINED|STRAINPHLAN_SELECT_CLADES|MULTIQC' {
        cpus   = 2
        memory = 4.GB
    }
    withName: STRAINPHLAN_SAMPLE2MARKERS {
        cpus   = 2
        memory = 4.GB
    }
    withName: STRAINPHLAN_CLADE {
        cpus   = 2
        memory = 4.GB
    }
}

timeline.enabled = false
report.enabled   = false
trace.enabled    = false
dag.enabled      = false
