/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ttf-metaphlan Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Shotgun Taxonomic Profiling (MetaPhlAn 4) for TreeTopFlow.
    Research use only. Not for clinical or diagnostic use.
----------------------------------------------------------------------------------------
*/

params {
    help                       = false
    input                      = null
    outdir                     = null
    metadata                   = null
    // Default MetaPhlAn 4 database on refdb.treetopunder.com will be wired once uploaded.
    metaphlan_db               = null
    // Default GRCh38_noalt_as Bowtie2 host index on refdb.treetopunder.com will be wired once uploaded.
    host_index                 = null
    skip_host_removal          = false
    analysis_type              = 'rel_ab_w_read_stats'
    add_viruses                = false
    unclassified_estimation    = true
    min_read_len               = 70
    skip_krona                 = false
    skip_phyloseq              = false

    publish_dir_mode           = 'copy'
    monochrome_logs            = false

    max_cpus                   = 16
    max_memory                 = '128.GB'
    max_time                   = '240.h'

    aws_queue                  = null
    aws_region                 = null
    aws_cli_path               = null
}

manifest {
    name            = 'ttf-metaphlan'
    author          = 'sjoclaudi'
    homePage        = 'https://github.com/sjoclaudi/ttf-metaphlan'
    description     = 'Shotgun Taxonomic Profiling (MetaPhlAn 4) — research use only'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
    doi             = ''
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
}

includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes           = true
        process.beforeScript = 'echo $HOSTNAME'
    }
    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
    }
    docker {
        docker.enabled       = true
        docker.registry      = 'quay.io'
        conda.enabled        = false
        singularity.enabled  = false
        docker.runOptions    = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    awsbatch {
        includeConfig 'conf/awsbatch.config'
    }
}

includeConfig 'conf/modules.config'

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1) {
                return params.max_memory as nextflow.util.MemoryUnit
            }
            return obj
        } catch (all) {
            println "WARNING: Max memory '${params.max_memory}' is invalid. Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1) {
                return params.max_time as nextflow.util.Duration
            }
            return obj
        } catch (all) {
            println "WARNING: Max time '${params.max_time}' is invalid. Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj, params.max_cpus as int)
        } catch (all) {
            println "WARNING: Max cpus '${params.max_cpus}' is invalid. Using default value: $obj"
            return obj
        }
    }
}
